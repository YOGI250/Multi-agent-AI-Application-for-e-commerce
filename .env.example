# ==========================================
# LLM PROVIDER
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL_NAME=llama-3.3-70b-versatile

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://ecommerce_user:your_password@localhost:5432/ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=ecommerce_db

# ==========================================
# LANGFUSE
# ==========================================
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_NEXTAUTH_SECRET=your_nextauth_secret_here
LANGFUSE_SALT=your_salt_here

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here

# ==========================================
# SESSION
# ==========================================
SESSION_EXPIRY_MINUTES=30
HISTORY_WINDOW_SIZE=10

# ==========================================
# APPLICATION
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ==========================================
# GRAFANA
# ==========================================
GRAFANA_ADMIN_PASSWORD=admin

# ==========================================
# PROMETHEUS
# ==========================================
PROMETHEUS_PORT=9090

# ==========================================
# PROMPT VERSIONS
# ==========================================
INTENT_ROUTER_PROMPT_LABEL=production
ORDER_RESPONSE_PROMPT_LABEL=production
ORDER_ANALYSIS_PROMPT_LABEL=production

# ==========================================
# COSTS
# ==========================================
GROQ_INPUT_COST_PER_MILLION=0.59
GROQ_OUTPUT_COST_PER_MILLION=0.79

# ==========================================
# INTENT ROUTER
# ==========================================
INTENT_CONFIDENCE_THRESHOLD=0.7

# ==========================================
# SUPPORT AGENT
# ==========================================
SUPPORT_HIGH_VALUE_THRESHOLD=10000.0

# ==========================================
# PRODUCT AGENT
# ==========================================
PRODUCT_SEARCH_CANDIDATES=20
PRODUCT_RECOMMENDATION_COUNT=8
PRODUCT_DEFAULT_MAX_PRICE=100000.0
PRODUCT_PRICE_BROADEN_FACTOR=1.5

# ==========================================
# EVALUATION
# ==========================================
EVAL_USER_ID=your_google_user_id_here