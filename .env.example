# ==========================================
# LLM PROVIDER
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL_NAME=llama3-8b-8192

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_agent_db

# ==========================================
# LANGFUSE
# ==========================================
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=http://localhost:3000

# ==========================================
# SESSION
# ==========================================
SESSION_EXPIRY_MINUTES=30

# ==========================================
# APPLICATION
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ==========================================
# PROMETHEUS
# ==========================================
PROMETHEUS_PORT=9090

# ==========================================
# LANGFUSE PROMPT VERSIONS
# ==========================================
INTENT_ROUTER_PROMPT_VERSION=1
ORDER_RESPONSE_PROMPT_VERSION=1


POSTGRES_PASSWORD=placeholder
POSTGRES_USER=placeholder
POSTGRES_DB=placeholder
GRAFANA_ADMIN_PASSWORD=placeholder
LANGFUSE_NEXTAUTH_SECRET=placeholder
LANGFUSE_SALT=placeholder
GROQ_INPUT_COST_PER_MILLION=0.59
GROQ_OUTPUT_COST_PER_MILLION=0.79
